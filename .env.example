APP_NAME="Hormozgan Digital Museum"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Hormozgan Digital Museum
MUSEUM_MIN_FACT_STATUS=source_verified
MUSEUM_CRAWLER_UA="HormozganDigitalMuseumBot/1.0 (+https://your-domain.example/museum/about/crawler)"
# AI (Claude via the official Anthropic PHP SDK). Set MUSEUM_LLM_DRIVER=null to disable AI features.
MUSEUM_LLM_DRIVER=anthropic
ANTHROPIC_API_KEY=
MUSEUM_LLM_MODEL=claude-opus-5-5
MUSEUM_LLM_EFFORT=medium
# Embeddings: hashing (offline lexical) | voyage | openai_compatible
MUSEUM_EMBEDDINGS_DRIVER=hashing
MUSEUM_EMBEDDINGS_API_KEY=
MUSEUM_VECTOR_DRIVER=database
MUSEUM_SEARCH_DRIVER=database
# Storage: local in development; s3 in production (S3-compatible object storage)
MUSEUM_RAW_DRIVER=local
MUSEUM_MEDIA_DRIVER=local
MUSEUM_BACKUP_DRIVER=local
MUSEUM_CDN_URL=
MUSEUM_BACKUP_RETENTION_DAYS=90
MUSEUM_OCR_DRIVER=tesseract
MUSEUM_TRANSCRIBE_URL=
